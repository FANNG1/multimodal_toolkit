# 本地 K8s 音频链路的完整 CPU runtime。
# 此镜像与项目 uv.lock 保持一致，包含真实 SenseVoice 所需依赖和 system codec；
# Kubernetes 资源声明不申请 GPU，CUDA 相关依赖即使存在也不会被使用。
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.9.17 /uv /uvx /bin/

WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    # PyPI 上的 Linux ARM64 Torch 依赖包含数百 MiB 的 CUDA wheel；本地网络较慢时，
    # 解压阶段可能超过默认超时。保留有限下载并发，并把单个请求/解压的超时提高到 15 分钟。
    UV_HTTP_TIMEOUT=900 \
    UV_CONCURRENT_DOWNLOADS=2 \
    PATH=/opt/venv/bin:$PATH \
    CUDA_VISIBLE_DEVICES=""

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        build-essential ffmpeg libsndfile1 wget curl git \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev
# 项目锁定 Ray 本体；最终 `uv sync` 会移除不在 lock 中的额外包，故必须在其之后
# 安装 KubeRay health check 和 Ray Dashboard 需要的 default extra。
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /opt/venv/bin/python "ray[default]==2.55.1"
